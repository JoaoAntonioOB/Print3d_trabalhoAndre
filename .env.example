# Copie para .env (NUNCA commitar o .env real).
POSTGRES_DB=print3d_mobile
POSTGRES_USER=print3d
# Use 5433 se a 5432 estiver ocupada (ex.: PostgreSQL local no Windows); ajuste DATABASE_URL junto.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=troque-esta-senha

# API (perfil prod). Segredo JWT Base64 >= 32 bytes: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-base64-de-48-bytes
JWT_ACCESS_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=*

# App mobile (Expo): IP da maquina na rede local, ex.: http://192.168.0.10:8080/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Usuario de demonstracao (criado pela migration V2). Troque em producao.
# E-mail: demo@print3d.com | Senha: demo123
